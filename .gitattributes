# Keep text files identical on Windows, macOS and Linux. Windows-only scripts
# retain CRLF because they are commonly edited and executed by native tools.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Keep GitHub language stats focused on application/source code.

# Documentation
docs/** linguist-documentation
developer-docs/** linguist-documentation
README.md linguist-documentation
README.zh.md linguist-documentation
CHANGELOG.md linguist-documentation
CONTRIBUTING.md linguist-documentation
LICENSE linguist-documentation

# Tests
# Use vendored here so they are excluded from language stats
# without being hidden by default in diffs.
tests/**/* linguist-vendored
scripts/*.sh linguist-vendored
frontend-panel/src/**/*.test.ts linguist-vendored
frontend-panel/src/**/*.test.tsx linguist-vendored

# Generated files
frontend-panel/src/services/api.generated.ts linguist-generated
